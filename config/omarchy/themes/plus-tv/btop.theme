# Plus TV Theme - btop Vivid Edition
# Main background: empty for transparent background inheriting terminal blur
theme[main_bg]=""

# Main text color
theme[main_fg]="#f8fafc"

# Title color for boxes
theme[title]="#00f5ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff0055"

# Background color of selected item in processes box
theme[selected_bg]="#8b00ff"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#717b9b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#ff007f"

# Box outline and divider line color
theme[cpu_box]="#ff0055"
theme[mem_box]="#8b00ff"
theme[net_box]="#00f5ff"
theme[proc_box]="#ff007f"
theme[div_line]="#121428"

# Gradient for all meters and graphs
theme[temp_start]="#00f57a"
theme[temp_mid]="#ffd600"
theme[temp_end]="#ff0055"

theme[cpu_start]="#00f5ff"
theme[cpu_mid]="#8b00ff"
theme[cpu_end]="#ff0055"

theme[free_start]="#00f57a"
theme[free_mid]="#00f5ff"
theme[free_end]="#3072ff"

theme[cached_start]="#8b00ff"
theme[cached_mid]="#ff007f"
theme[cached_end]="#ff0055"

theme[available_start]="#00f57a"
theme[available_mid]="#ffd600"
theme[available_end]="#ff0055"

theme[used_start]="#00f5ff"
theme[used_mid]="#8b00ff"
theme[used_end]="#ff0055"

theme[download_start]="#3072ff"
theme[download_mid]="#00f5ff"
theme[download_end]="#00f57a"

theme[upload_start]="#8b00ff"
theme[upload_mid]="#ff007f"
theme[upload_end]="#ff0055"
