#!/bin/bash
# Ensure Omarchy background layer has alpha=1 and is visible
alpha=$(hyprctl layers -j 2>/dev/null | jq -r '.. | select(.namespace? == "omarchy-background") | .alpha' 2>/dev/null | head -n 1)
if [[ "$alpha" == "0" ]]; then
  omarchy-shell background setSuspended true >/dev/null 2>&1
  sleep 0.05
  omarchy-shell background setSuspended false >/dev/null 2>&1
fi
